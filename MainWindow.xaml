<Window x:Class="ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Panel" 
        Height="450" Width="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <!-- Главный контейнер: фиолетовое полупрозрачное стекло -->
    <Border Background="#CC2D1B4E" 
            CornerRadius="20" 
            BorderBrush="#609B59FF" 
            BorderThickness="2"
            MouseDown="Grid_MouseDown">

        <!-- Тень для эффекта парения -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="30">
            <!-- Две строки: заголовок + основной контент -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Две колонки: кнопки слева, ползунки справа -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовок (на всю ширину) -->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="⚡ Control Panel" 
                       Foreground="White" 
                       FontSize="28" 
                       FontWeight="Bold"
                       FontFamily="Segoe UI Emoji"
                       HorizontalAlignment="Center" 
                       Margin="0, 10, 0, 30"/>

            <!-- ЛЕВАЯ КОЛОНКА: Кнопки -->
            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Кнопка 1: Браузер -->
                <Button Width="280" Height="55" 
                        FontSize="18" 
                        FontFamily="Segoe UI Emoji"
                        Margin="0, 0, 0, 15"
                        Click="OpenBrowser_Click">
                    <Button.Content>
                        <TextBlock Text="🌐 Браузер" Foreground="White"/>
                    </Button.Content>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="#409B59FF"
                                    BorderBrush="#809B59FF"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#709B59FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Кнопка 2: Visual Studio -->
                <Button Width="280" Height="55" 
                        FontSize="18" 
                        FontFamily="Segoe UI Emoji"
                        Margin="0, 0, 0, 15"
                        Click="OpenVS_Click">
                    <Button.Content>
                        <TextBlock Text="💻 Visual Studio" Foreground="White"/>
                    </Button.Content>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="#409B59FF"
                                    BorderBrush="#809B59FF"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#709B59FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Кнопка 3: Калькулятор -->
                <Button Width="280" Height="55" 
                        FontSize="18" 
                        FontFamily="Segoe UI Emoji"
                        Click="OpenCalc_Click">
                    <Button.Content>
                        <TextBlock Text="🧮 Калькулятор" Foreground="White"/>
                    </Button.Content>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="#409B59FF"
                                    BorderBrush="#809B59FF"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#709B59FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- ПРАВАЯ КОЛОНКА: Ползунки -->
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Ползунок яркости -->
                <TextBlock Text="☀️ Яркость" 
                           Foreground="White" 
                           FontSize="20" 
                           FontFamily="Segoe UI Emoji"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"/>

                <Slider x:Name="BrightnessSlider" 
                        Width="280" 
                        Minimum="30" Maximum="100" 
                        Value="100"
                        ValueChanged="BrightnessSlider_ValueChanged"/>

                <TextBlock x:Name="BrightnessValue" 
                           Text="100%" 
                           Foreground="White" 
                           FontSize="18"
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,30"/>

                <!-- Ползунок громкости -->
                <TextBlock Text="🔊 Громкость" 
                           Foreground="White" 
                           FontSize="20" 
                           FontFamily="Segoe UI Emoji"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"/>

                <Slider x:Name="VolumeSlider" 
                        Width="280" 
                        Minimum="0" Maximum="100" 
                        Value="50"
                        ValueChanged="VolumeSlider_ValueChanged"/>

                <TextBlock x:Name="VolumeValue" 
                           Text="50%" 
                           Foreground="White" 
                           FontSize="18"
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>