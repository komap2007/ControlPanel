<!-- Объявляем главное окно приложения -->
<Window x:Class="ControlPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Моя Панель" Height="300" Width="400"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ResizeMode="NoResize">
    
    <!-- Сетка-контейнер с фиолетовым фоном -->
    <Grid Background="#CC6B2FA0" MouseDown="Grid_MouseDown">

        <!-- Текст заголовка -->
        <TextBlock Text="Моя панель управления"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0, 20, 0, 20"/>

        <!-- Кнопка по центру окна -->
        <Button Content="Нажми на меня"
                Width="150"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="Button_Click"/>
    </Grid>
</Window>