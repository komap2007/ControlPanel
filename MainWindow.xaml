<!-- Объявляем главное окно приложения -->
<Window x:Class="ControlPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Моя Панель" Height="300" Width="400"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ResizeMode="NoResize">
    
    <!-- Сетка-контейнер с фиолетовым фоном -->
    <Grid Background="#CC6B2FA0" MouseDown="Grid_MouseDown">

        <!--  Заголовок -->
        <TextBlock Text="Моя панель управления" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 20, 0, 20"/>

        <!-- Контейнер для кнопок (располагает их вертикально) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Кнопка 1: Открыть браузер -->
            <Button Content="Открыть Chrome" Width="200" Height="45" FontSize="16" Margin="0, 10, 0, 0"
                    Click="OpenBrowser_Click"/>
            
            <!-- Кнопка 2: Открыть Visual Studio -->
            <Button Content="Открыть VS" Width="200" Height="45" FontSize="16" Margin="0, 10, 0, 0"
                    Click="OpenVS_Click"/>

            <!-- Кнопка 3: Калькулятор -->
            <Button Content="🧮 Калькулятор" Width="200" Height="45" FontSize="16" Margin="0, 15, 0, 0"
                Click="OpenCalc_Click"/>

        </StackPanel>
    </Grid>
</Window>